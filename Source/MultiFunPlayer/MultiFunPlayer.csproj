<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>..\..\Assets\icon.ico</ApplicationIcon>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>true</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  
  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
  </ItemGroup>
    
  <ItemGroup>
    <ProjectReference Include="..\MultiFunPlayer.Core\MultiFunPlayer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- These platform-neutral contracts now live in MultiFunPlayer.Core. -->
    <Compile Remove="Common\BroadcastEvent.cs" />
    <Compile Remove="Common\DeviceAxis.cs" />
    <Compile Remove="Common\DeviceSettings.cs" />
    <Compile Remove="Common\IDeviceAxisValueProvider.cs" />
    <Compile Remove="Common\Keyframe.cs" />
    <Compile Remove="Common\KeyframeCollection.cs" />
    <Compile Remove="Common\SplittingStringBuffer.cs" />
    <Compile Remove="Common\TypedValue.cs" />
    <Compile Remove="Common\Utils\DeviceAxisUtils.cs" />
    <Compile Remove="Common\Utils\MathUtils.cs" />
    <Compile Remove="Input\IInputGesture.cs" />
    <Compile Remove="Input\IInputGestureData.cs" />
    <Compile Remove="Input\IInputGestureDescriptor.cs" />
    <Compile Remove="Input\TCode\TCodeAxisGesture.cs" />
    <Compile Remove="Input\TCode\TCodeButtonGesture.cs" />
    <Compile Remove="Script\Bookmark.cs" />
    <Compile Remove="Script\BookmarkCollection.cs" />
    <Compile Remove="Script\Chapter.cs" />
    <Compile Remove="Script\ChapterCollection.cs" />
    <Compile Remove="Script\IScriptReader.cs" />
    <Compile Remove="Script\IScriptResource.cs" />
    <Compile Remove="Script\IScriptWriter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Buttplug.Net" Version="0.1.0-ci0094" />
    <PackageReference Include="Buttplug.Net.NewtonsoftJson" Version="0.1.0-ci0094" />
    <PackageReference Include="ConfigureAwait.Fody" Version="3.4.1">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MahApps.Metro" Version="2.4.9" />
    <PackageReference Include="MaterialDesignThemes" Version="4.7.0" />
    <PackageReference Include="MaterialDesignThemes.MahApps" Version="0.2.6" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="NETStandard.Library" Version="2.0.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="5.5.1" />
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="RawInput.Sharp" Version="0.1.3" />
    <PackageReference Include="Stylet" Version="1.3.7" />
    <PackageReference Include="System.IO.Ports" Version="9.0.18" />
    <PackageReference Include="System.Management" Version="9.0.18" />
    <PackageReference Include="Vortice.XInput" Version="3.8.3" />
  </ItemGroup>
</Project>
