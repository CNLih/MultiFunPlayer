<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MultiFunPlayer.Server</AssemblyName>
    <RootNamespace>MultiFunPlayer.Server</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MultiFunPlayer.Application\MultiFunPlayer.Application.csproj" />
    <ProjectReference Include="..\MultiFunPlayer.Core\MultiFunPlayer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\MultiFunPlayer.Web\static\index.html" Link="wwwroot\index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\MultiFunPlayer.Web\public\**" Link="wwwroot\public\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
