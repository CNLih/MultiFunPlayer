<Project>
  <PropertyGroup>
    <!-- Keep every restore reproducible; CI restores in locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- WPF projects can be restored from Linux when the SDK is provisioned there. -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
