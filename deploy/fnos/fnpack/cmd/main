#!/bin/sh
set -eu

case "${1:-}" in
    start|stop)
        # Docker projects are started and stopped by the fnOS app manager.
        exit 0
        ;;
    status)
        # The package user cannot access the Docker socket. Probe the public
        # health endpoint with a bounded timeout so fnOS can track app state.
        if curl --noproxy '*' --fail --silent --connect-timeout 2 --max-time 3 \
            --output /dev/null "http://127.0.0.1:${TRIM_SERVICE_PORT:-8081}/health/live"; then
            exit 0
        fi
        exit 3
        ;;
    *)
        exit 1
        ;;
esac
